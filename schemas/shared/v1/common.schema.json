{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai-commerce.dev/schemas/shared/v1/common.schema.json",
  "title": "CommonDefinitions",
  "description": "Reusable primitive types and patterns referenced across all configuration schemas.",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "RFC 4122 UUID identifier."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64,
      "description": "URL-safe lowercase slug."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "localeCode": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP 47 language tag (e.g. en, en-US, ur-PK)."
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code (e.g. USD, PKR, EUR)."
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code."
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA timezone identifier (e.g. Asia/Karachi)."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "description": "CSS hex color (#RGB, #RRGGBB, or #RRGGBBAA)."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[\\w.]+)?(?:\\+[\\w.]+)?$",
      "description": "Semantic version string."
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 date-time in UTC."
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "enabledFlag": {
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary key-value metadata for integrations and extensions.",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
