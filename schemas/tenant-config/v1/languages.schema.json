{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.ai-commerce.dev/schemas/tenant-config/v1/languages.schema.json",
  "title": "Languages",
  "description": "Locale and internationalization settings for the tenant.",
  "type": "object",
  "required": ["default", "supported", "fallback"],
  "additionalProperties": false,
  "properties": {
    "default": {
      "$ref": "../../shared/v1/common.schema.json#/$defs/localeCode"
    },
    "supported": {
      "type": "array",
      "items": {
        "$ref": "../../shared/v1/common.schema.json#/$defs/localeCode"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fallback": {
      "$ref": "../../shared/v1/common.schema.json#/$defs/localeCode"
    },
    "rtlLocales": {
      "type": "array",
      "items": {
        "$ref": "../../shared/v1/common.schema.json#/$defs/localeCode"
      },
      "uniqueItems": true,
      "description": "Locales rendered right-to-left (e.g. ar, ur)."
    },
    "autoDetect": {
      "type": "boolean",
      "default": true,
      "description": "Detect user locale from browser/device settings."
    },
    "allowUserOverride": {
      "type": "boolean",
      "default": true,
      "description": "Allow end users to switch language in the app."
    }
  }
}
