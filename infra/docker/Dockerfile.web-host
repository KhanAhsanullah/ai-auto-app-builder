# Demo / staging web Boom storefront (Sprint 30 Task 1)
FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web-host ./apps/web-host
COPY apps/web-store ./apps/web-store
COPY packages ./packages
COPY modules ./modules
COPY platform ./platform
COPY schemas ./schemas

RUN pnpm install --frozen-lockfile --filter @ai-commerce/web-host...

# Browser calls host-mapped API; override at compose/runtime if needed.
ENV VITE_PLATFORM_API_URL=http://127.0.0.1:8787
ENV NODE_ENV=development

EXPOSE 5173
WORKDIR /app/apps/web-host

CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5173"]
