# Demo / staging control-plane API (Sprint 30 Task 1)
FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/platform-api ./apps/platform-api
COPY packages ./packages
COPY platform/config-engine ./platform/config-engine
COPY platform/tenant-provisioner ./platform/tenant-provisioner
COPY schemas ./schemas

RUN pnpm install --frozen-lockfile --filter @ai-commerce/platform-api...

ENV HOST=0.0.0.0
ENV PORT=8787
ENV NODE_ENV=production

EXPOSE 8787
WORKDIR /app/apps/platform-api
VOLUME ["/data"]

CMD ["pnpm", "exec", "tsx", "./src/infrastructure/start-server.ts"]
