# Demo / staging merchant admin (Sprint 30 Task 2)
FROM node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/admin-host ./apps/admin-host
COPY apps/admin-dashboard ./apps/admin-dashboard
COPY packages ./packages
COPY modules ./modules
COPY platform ./platform
COPY schemas ./schemas

RUN pnpm install --frozen-lockfile --filter @ai-commerce/admin-host...

# Browser calls host-mapped API (same volume-backed data as web Boom).
ENV VITE_PLATFORM_API_URL=http://127.0.0.1:8787
ENV NODE_ENV=development

EXPOSE 5174
WORKDIR /app/apps/admin-host

CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5174"]
