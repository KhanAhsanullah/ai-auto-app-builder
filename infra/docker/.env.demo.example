# CommerceOS AI — demo / staging Compose overrides (Sprint 30 Task 3)
# Copy next to docker-compose.demo.yml as `.env` or pass via `docker compose --env-file`.
#
# Browser must reach the API at a host:port that works FROM THE CLIENT MACHINE
# (localhost for laptop demos; public HTTPS origin for hosted staging).

# --- platform-api ---
# HOST=0.0.0.0
# PORT=8787
# TENANT_STORE_PATH=/data/tenants.json
# CONFIG_STORE_PATH=/data/configs.json
# CATALOG_STORE_PATH=/data/catalogs.json

# --- web-host + admin-host (Vite) ---
# Local Docker default:
VITE_PLATFORM_API_URL=http://127.0.0.1:8787

# Hosted example (replace with your public API origin):
# VITE_PLATFORM_API_URL=https://api.demo.example.com
