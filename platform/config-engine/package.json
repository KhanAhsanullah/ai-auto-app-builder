{
  "name": "@ai-commerce/config-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Control-plane service for tenant configuration CRUD, versioning, diff, validation, and publish events that trigger downstream rebuilds.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo \"dev not configured yet\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-runtime": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^3.0.5"
  }
}
