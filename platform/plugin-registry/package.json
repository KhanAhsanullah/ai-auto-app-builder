{
  "name": "@ai-commerce/plugin-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Control-plane service for plugin discovery, manifest validation, installation, and hook registration per tenant.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo \"dev not configured yet\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-runtime": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*",
    "ajv": "^8.17.1",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "vitest": "^3.0.5"
  }
}
