{
  "name": "@ai-commerce/config-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime configuration resolver with inheritance: platform defaults → vertical preset → tenant override → environment. Used by all apps and services.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo \"dev not configured yet\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-schema": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^3.0.5"
  }
}
