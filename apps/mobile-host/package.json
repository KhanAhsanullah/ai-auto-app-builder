{
  "name": "@ai-commerce/mobile-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "prebuild": "EXPO_NO_TELEMETRY=1 expo prebuild",
    "prebuild:clean": "EXPO_NO_TELEMETRY=1 expo prebuild --clean",
    "eas:build:development": "npx --yes eas-cli build --profile development --platform all",
    "eas:build:preview": "npx --yes eas-cli build --profile preview --platform all",
    "eas:build:production": "npx --yes eas-cli build --profile production --platform all",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-commerce/mobile-app": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-dev-client": "~5.2.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "vitest": "^3.0.5"
  }
}
