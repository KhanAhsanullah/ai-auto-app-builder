{
  "expo": {
    "name": "CommerceOS Mobile",
    "slug": "ai-commerce-mobile-host",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "aicommerce",
    "platforms": ["ios", "android", "web"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.commerce.mobilehost",
      "buildNumber": "1"
    },
    "android": {
      "package": "ai.commerce.mobilehost",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "aicommerce"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": ["expo-sqlite"]
  }
}
