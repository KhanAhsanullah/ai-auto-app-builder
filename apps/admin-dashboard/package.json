{
  "name": "@ai-commerce/admin-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Generated merchant admin dashboard shell and platform administration surface. Consumes tenant configuration, theme tokens, and navigation manifests to render a branded management experience.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo \"dev not configured yet\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-runtime": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*",
    "@ai-commerce/module-cart": "workspace:*",
    "@ai-commerce/module-catalog": "workspace:*",
    "@ai-commerce/module-checkout": "workspace:*",
    "@ai-commerce/module-order": "workspace:*",
    "@ai-commerce/module-payment": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  }
}
