{
  "name": "@ai-commerce/mobile-app",
  "version": "0.0.0",
  "private": true,
  "description": "React Native consumer mobile application shell. Shares business logic with web via ui-core and sdk-client; styling via theme-engine compiled tokens.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo \"dev not configured yet\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-runtime": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*",
    "@ai-commerce/module-cart": "workspace:*",
    "@ai-commerce/module-catalog": "workspace:*",
    "@ai-commerce/module-checkout": "workspace:*",
    "react": "^19.0.0",
    "react-native": "^0.78.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  }
}
