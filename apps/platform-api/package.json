{
  "name": "@ai-commerce/platform-api",
  "version": "0.0.0",
  "private": true,
  "description": "Control-plane API for tenant provisioning, configuration management, theme publishing, and platform administration operations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types ./src/infrastructure/start-server.ts",
    "start": "node --experimental-strip-types ./src/infrastructure/start-server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-engine": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*",
    "@ai-commerce/tenant-provisioner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^3.0.5"
  }
}
