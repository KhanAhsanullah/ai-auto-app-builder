{
  "name": "@ai-commerce/web-store",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer-facing web storefront shell (SSR). Renders catalog, cart, and checkout flows driven entirely by shared tenant configuration and feature modules.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
