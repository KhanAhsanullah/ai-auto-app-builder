    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-commerce/config-runtime": "workspace:*",
    "@ai-commerce/config-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^3.0.5"
  }
